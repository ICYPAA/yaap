{
  "expo": {
    "name": "YAAP!",
    "slug": "icypaa",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/branding/icypaa-generic/icon.png",
    "scheme": "yaap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.themindfulpug.icypaa",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "YAAP! needs access to your photo library for you to choose a profile picture.",
        "CFBundleDisplayName": "YAAP!",
        "NSCameraUsageDescription": "YAAP! needs access to your camera to scan QR codes.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      },
      "usesAppleSignIn": true,
      "buildNumber": "52"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/icypaa-generic/icon.png",
        "backgroundColor": "#263869"
      },
      "package": "com.themindfulpug.yaap",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "googleServicesFile": "./google-services.json",
      "versionCode": 19
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/branding/icypaa-generic/icon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "project": "yaap",
          "organization": "the-mindful-pug"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "15c03e66-5f31-409b-b31a-b53b92e00fb1"
      }
    },
    "owner": "the-mindful-pug",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/15c03e66-5f31-409b-b31a-b53b92e00fb1"
    }
  }
}
