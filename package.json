{
  "name": "yaap-monorepo",
  "private": true,
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:mobile": "turbo dev --filter=@yaap/mobile",
    "dev:admin": "turbo dev --filter=@yaap/admin-web",
    "dev:functions": "turbo dev --filter=@yaap/functions",
    "dev:admin:local": "./scripts/dev-admin-local.sh",
    "dev:admin:vercel:local": "./scripts/dev-admin-vercel-local.sh",
    "dev:mobile:local": "./scripts/dev-mobile-local.sh",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "supabase:start": "cd apps/functions && supabase start",
    "supabase:stop": "cd apps/functions && supabase stop",
    "supabase:status": "cd apps/functions && supabase status",
    "supabase:login": "supabase login",
    "supabase:link": "cd apps/functions && supabase link --project-ref ${SUPABASE_PROJECT_REF:-oolqeopfhhiuvsmamxln}",
    "supabase:db:reset": "cd apps/functions && supabase db reset",
    "supabase:migration:new": "cd apps/functions && supabase migration new",
    "supabase:functions:serve": "cd apps/functions && supabase functions serve"
  },
  "devDependencies": {
    "turbo": "^2.8.10"
  }
}
