{
  "name": "yaap-monorepo",
  "private": true,
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:mobile": "turbo dev --filter=@yaap/mobile",
    "dev:admin": "turbo dev --filter=@yaap/admin-web",
    "dev:functions": "turbo dev --filter=@yaap/functions",
    "setup:local": "./scripts/setup-local.sh",
    "setup:local:reset": "./scripts/setup-local.sh --reset",
    "local:env": "./scripts/configure-local-env.sh",
    "local:verify": "./scripts/verify-local-db.sh",
    "dev:admin:local": "./scripts/dev-admin-local.sh",
    "dev:admin:vercel:local": "./scripts/dev-admin-vercel-local.sh",
    "dev:mobile:local": "./scripts/dev-mobile-local.sh",
    "dev:mobile:web:local": "./scripts/dev-mobile-local.sh --web",
    "e2e:reset": "pnpm setup:local:reset",
    "e2e:mobile:ios": "./scripts/e2e-mobile-ios.sh",
    "e2e:admin": "pnpm e2e:reset && pnpm --filter @yaap/admin-web e2e",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "supabase:start": "cd apps/functions && supabase start",
    "supabase:stop": "cd apps/functions && supabase stop",
    "supabase:status": "cd apps/functions && supabase status",
    "supabase:login": "supabase login",
    "supabase:link": "cd apps/functions && supabase link --project-ref ${SUPABASE_PROJECT_REF:-oolqeopfhhiuvsmamxln}",
    "supabase:db:reset": "cd apps/functions && supabase db reset",
    "supabase:migration:up": "cd apps/functions && supabase migration up --local",
    "supabase:migration:new": "cd apps/functions && supabase migration new",
    "supabase:functions:serve": "cd apps/functions && supabase functions serve"
  },
  "devDependencies": {
    "supabase": "2.75.0",
    "turbo": "^2.8.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "sharp",
      "unrs-resolver",
      "supabase"
    ],
    "packageExtensions": {
      "@react-native-community/datetimepicker@8.6.0": {
        "dependencies": {
          "@expo/config-plugins": "55.0.11"
        }
      }
    },
    "overrides": {
      "@babel/plugin-transform-modules-systemjs": "7.29.7",
      "@xmldom/xmldom": "0.8.13",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "axios": "1.17.0",
      "@babel/core": "7.29.6",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.1": "2.1.1",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "fast-uri": "3.1.2",
      "follow-redirects": "1.16.0",
      "lodash": "4.18.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "node-forge": "1.4.0",
      "picomatch": "3.0.2",
      "js-yaml@<3.15.0": "3.15.0",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "postcss": "8.5.23",
      "qs": "6.15.2",
      "sharp": "0.35.0",
      "shell-quote": "1.9.0",
      "tar": "7.5.16",
      "undici": "6.26.0",
      "uuid": "11.1.1",
      "ws": "8.21.0",
      "yaml@>=2.0.0 <2.8.3": "2.8.3"
    }
  }
}
